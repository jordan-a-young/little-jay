{
  "name": "little-jay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "secrets:install": "sh scripts/install-gitleaks.sh",
    "secrets:staged": "node scripts/check-secrets.mjs staged",
    "secrets:scan": "node scripts/check-secrets.mjs history",
    "dev": "pnpm --filter \"@littlejay/ui...\" build && pnpm --filter @littlejay/playground dev",
    "dev:server": "pnpm --filter @littlejay/server build && pnpm --filter @littlejay/api dev:demo",
    "build": "vp run -r build",
    "check": "node scripts/build-tokens.mjs --check && vp check",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage && node scripts/check-coverage.mjs",
    "fmt": "vp fmt",
    "test:packages": "node scripts/test-packages.mjs",
    "test:server-compat": "node scripts/test-server-compatibility.ts",
    "changeset": "changeset",
    "release:validate": "node scripts/release.mjs validate",
    "release:status": "node scripts/release.mjs status",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "release:stage": "node scripts/release.mjs stage",
    "release:inspect": "node scripts/release.mjs inspect",
    "release:source": "node scripts/release.mjs source",
    "release:verify-finalization": "node scripts/release.mjs verify-finalization",
    "release:finalize": "node scripts/release.mjs finalize",
    "ready": "pnpm release:validate && pnpm check && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm test:packages"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/read": "1.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.18.0"
}
