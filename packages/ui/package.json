{
  "name": "@ljay/ui",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "theme.css",
    "tailwind.css",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./theme.css",
    "./tailwind.css": "./tailwind.css",
    "./field": {
      "types": "./dist/field.d.ts",
      "development": "./src/field/index.tsx",
      "import": "./dist/field.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "development": "./src/input/index.tsx",
      "import": "./dist/input.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "development": "./src/textarea/index.tsx",
      "import": "./dist/textarea.js"
    },
    "./native-select": {
      "types": "./dist/native-select.d.ts",
      "development": "./src/native-select/index.tsx",
      "import": "./dist/native-select.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "development": "./src/checkbox/index.tsx",
      "import": "./dist/checkbox.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "development": "./src/alert/index.tsx",
      "import": "./dist/alert.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state.d.ts",
      "development": "./src/empty-state/index.tsx",
      "import": "./dist/empty-state.js"
    },
    "./pebble-state": {
      "types": "./dist/pebble-state.d.ts",
      "development": "./src/pebble-state/index.tsx",
      "import": "./dist/pebble-state.js"
    },
    "./status-indicator": {
      "types": "./dist/status-indicator.d.ts",
      "development": "./src/status-indicator/index.tsx",
      "import": "./dist/status-indicator.js"
    },
    "./loading-indicator": {
      "types": "./dist/loading-indicator.d.ts",
      "development": "./src/loading-indicator/index.tsx",
      "import": "./dist/loading-indicator.js"
    },
    "./error-boundary": {
      "types": "./dist/error-boundary.d.ts",
      "development": "./src/error-boundary/index.tsx",
      "import": "./dist/error-boundary.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "development": "./src/button/index.tsx",
      "import": "./dist/button.js"
    },
    "./description-list": {
      "types": "./dist/description-list.d.ts",
      "development": "./src/description-list/index.tsx",
      "import": "./dist/description-list.js"
    },
    "./disclosure": {
      "types": "./dist/disclosure.d.ts",
      "development": "./src/disclosure/index.tsx",
      "import": "./dist/disclosure.js"
    },
    "./text-block": {
      "types": "./dist/text-block.d.ts",
      "development": "./src/text-block/index.tsx",
      "import": "./dist/text-block.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "development": "./src/icon-button/index.tsx",
      "import": "./dist/icon-button.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "development": "./src/tabs/index.tsx",
      "import": "./dist/tabs.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "development": "./src/dialog/index.tsx",
      "import": "./dist/dialog.js"
    }
  },
  "scripts": {
    "build": "vp pack && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ljay/brand": "workspace:*",
    "@ljay/tokens": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
